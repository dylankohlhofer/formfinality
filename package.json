{
  "name": "formfinality-test-lab",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test testing/lab.test.mjs testing/audio.test.mjs testing/audio-capture.test.mjs && node testing/run.mjs --build form-coach-v4.11.html",
    "test:watch": "node testing/watch.mjs --build form-coach-v4.11.html",
    "test:lab": "node testing/run.mjs --build form-coach-v4.11.html",
    "test:partial": "node testing/run.mjs --build form-coach-v4.11.html --pack partial-visibility",
    "test:infra": "node --test testing/lab.test.mjs testing/audio.test.mjs",
    "test:audio": "node testing/run.mjs --build form-coach-v4.11.html --mode audio",
    "test:audio:mutations": "node --test testing/audio-capture.test.mjs",
    "test:worker": "node --test testing/worker-queue.test.mjs && node testing/worker-benchmark.mjs",
    "test:video": "node testing/video-smoke.mjs form-coach-v4.11.html",
    "test:setup-video": "node testing/setup-video.mjs",
    "test:review": "node testing/run-ai-review.mjs",
    "business:model": "node commercial/economics.mjs",
    "build:web": "node release/build-web.mjs --build form-coach-v4.11.html",
    "test:release": "node --test testing/web-release.test.mjs testing/economics.test.mjs",
    "test:release:smoke": "node testing/web-release-smoke.mjs",
    "test:camera": "node testing/camera-e2e.mjs",
    "voice:audit": "node testing/voice-audit.mjs --all"
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "playwright": "1.55.1"
  },
  "engines": { "node": ">=20" }
}
